rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }
    function requestPath(needId) {
      return /databases/$(database)/documents/requests/$(needId);
    }
    function applicationPath(needId, uid) {
      return /databases/$(database)/documents/requests/$(needId)/applications/$(uid);
    }
    function indexPath(uid, needId) {
      return /databases/$(database)/documents/applicationsByUser/$(uid)/items/$(needId);
    }
    function owns(needId) {
      return signedIn() && get(requestPath(needId)).data.ownerUid == request.auth.uid;
    }
    function validProfile(uid, data) {
      return data.keys().hasAll(['uid','name','phone','email','discloseConsent','createdAt'])
        && data.keys().hasOnly(['uid','name','phone','email','discloseConsent','createdAt'])
        && data.uid == uid
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20
        && data.phone.matches('^[+0-9 ()-]{7,20}$')
        && data.email is string && data.email.size() <= 254
        && data.discloseConsent == true
        && data.createdAt is timestamp;
    }
    match /profiles/{uid} {
      allow get: if isUser(uid);
      allow list: if false;
      allow create: if isUser(uid)
        && validProfile(uid,request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isUser(uid)
        && validProfile(uid,request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isUser(uid);
    }
    function publicNeedFields(data) {
      return data.keys().hasAll([
        'ownerUid','title','city','category','subcategory','description','budget',
        'desiredDate','quantity','condition','picture','createdAt','status'
      ]) && data.keys().hasOnly([
        'ownerUid','title','city','category','subcategory','description','budget',
        'desiredDate','quantity','condition','picture','createdAt','status'
      ]);
    }
    function validPublicNeed(data) {
      return publicNeedFields(data)
        && data.ownerUid is string
        && data.title is string && data.title.size() >= 1
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.category in ['bienes','servicios']
        && data.subcategory is string && data.subcategory.size() >= 1 && data.subcategory.size() <= 80
        && data.description is string && data.description.size() >= 15 && data.description.size() <= 1500
        && (data.budget == null || (data.budget is int && data.budget >= 0 && data.budget <= 1000000000000))
        && data.desiredDate is string && data.desiredDate.size() <= 10
        && (data.quantity == null || (data.quantity is int && data.quantity >= 1 && data.quantity <= 1000000))
        && (data.condition == null || data.condition in ['nuevo','usado','cualquiera'])
        && data.picture is string && data.picture.size() <= 400000
        && data.createdAt is timestamp
        && data.status in ['abierta','en_proceso','resuelta','cancelada'];
    }
    match /requests/{needId} {
      // No incluye datos de usuario, teléfono ni identificadores de interesados.
      allow get, list: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validPublicNeed(request.resource.data)
        && request.resource.data.status == 'abierta'
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && validPublicNeed(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','city','category','subcategory','description','budget','desiredDate',
          'quantity','condition','picture','status'
        ])
        && (
          (resource.data.status in ['abierta','en_proceso'] && request.resource.data.status in ['abierta','en_proceso','resuelta','cancelada'])
          || (resource.data.status == 'cancelada' && request.resource.data.status in ['cancelada','abierta'])
          || (resource.data.status == 'resuelta' && request.resource.data.status == 'resuelta')
        );
      allow delete: if false;

      match /applications/{applicantUid} {
        // Cada interesado puede leer su propia aplicación; el dueño puede consultar TODAS.
        allow get: if isUser(applicantUid) || owns(needId);
        allow list: if owns(needId);
        allow create: if isUser(applicantUid)
          && get(requestPath(needId)).data.status == 'abierta'
          && get(requestPath(needId)).data.ownerUid != applicantUid
          && exists(profilePath(applicantUid))
          && get(profilePath(applicantUid)).data.discloseConsent == true
          && request.resource.data.keys().hasAll(['uid','name','phone','appliedAt'])
          && request.resource.data.keys().hasOnly(['uid','name','phone','appliedAt'])
          && request.resource.data.uid == applicantUid
          && request.resource.data.name == get(profilePath(applicantUid)).data.name
          && request.resource.data.phone == get(profilePath(applicantUid)).data.phone
          && request.resource.data.appliedAt == request.time
          && getAfter(indexPath(applicantUid,needId)).data.requestId == needId;
        allow update, delete: if false;
      }
    }
    match /applicationsByUser/{uid}/items/{needId} {
      // Índice privado del interesado: no contiene datos de contacto.
      allow get, list: if isUser(uid);
      allow create: if isUser(uid)
        && request.resource.data.keys().hasAll(['requestId','appliedAt'])
        && request.resource.data.keys().hasOnly(['requestId','appliedAt'])
        && request.resource.data.requestId == needId
        && request.resource.data.appliedAt == request.time
        && getAfter(applicationPath(needId,uid)).data.uid == uid;
      allow update, delete: if false;
    }
    match /drafts/{uid} {
      allow get: if isUser(uid);
      allow list: if false;
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasAll(['data','editingRequestId','updatedAt'])
        && request.resource.data.keys().hasOnly(['data','editingRequestId','updatedAt'])
        && request.resource.data.editingRequestId is string
        && request.resource.data.data is map
        && request.resource.data.data.keys().hasOnly([
          'title','category','subcategory','city','quantity','condition',
          'description','budget','desiredDate','picture'
        ])
        && request.resource.data.data.picture is string
        && request.resource.data.data.picture.size() <= 400000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isUser(uid);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
