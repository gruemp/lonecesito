rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owns(data) {
      return signedIn() && data.ownerUid == request.auth.uid;
    }
    function validPublication(data) {
      return data.keys().hasAll([
        'ownerUid','createdAt','description','title','contactPhone','contactConsent'
      ]) && data.keys().hasOnly([
        'ownerUid','createdAt','description','title','contactPhone','contactConsent','picture'
      ])
      && data.ownerUid is string && data.ownerUid.size() > 0
      && data.createdAt is timestamp
      && data.description is string && data.description.size() >= 10 && data.description.size() <= 4000
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
      && data.contactPhone is string && data.contactPhone.matches('^[0-9]{10,15}$')
      && data.contactConsent == true
      && (!data.keys().hasAny(['picture']) ||
          (data.picture is string && data.picture.size() <= 400000));
    }
    match /requests/{requestId} {
      allow get, list: if true;
      allow create: if owns(request.resource.data)
        && validPublication(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if owns(resource.data)
        && validPublication(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description','title','contactPhone','contactConsent',
          // Solo se permite retirar los campos heredados de la interfaz antigua.
          'category','city','subcategory','quantity','condition','budget',
          'desiredDate','status'
        ]);
      allow delete: if owns(resource.data);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
