rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function own(data) {
      return signedIn() && data.ownerUid == request.auth.uid;
    }
    function validNeed(data) {
      return data.keys().hasAll([
          'ownerUid','title','category','city','description','contactPhone',
          'contactConsent','budget','quantity','condition','picture','createdAt'
        ])
        && data.keys().hasOnly([
          'ownerUid','title','category','city','description','contactPhone',
          'contactConsent','budget','quantity','condition','picture','createdAt',
          'subcategory','desiredDate','status'
        ])
        && data.ownerUid is string
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 120
        && data.category in ['bienes','servicios']
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.description is string && data.description.size() >= 15 && data.description.size() <= 1500
        && data.contactPhone is string
        && data.contactPhone.matches('^[0-9]{10,15}$')
        && data.contactConsent == true
        && (data.budget == null || (data.budget is int && data.budget >= 0 && data.budget <= 1000000000000))
        && (data.quantity == null || (data.quantity is int && data.quantity >= 1 && data.quantity <= 1000000))
        && (data.condition == null || data.condition in ['nuevo','usado','cualquiera'])
        && data.picture is string && data.picture.size() <= 400000
        && data.createdAt is timestamp
        // Campos heredados; no se generan en las publicaciones nuevas.
        && (!data.keys().hasAny(['subcategory']) || data.subcategory is string)
        && (!data.keys().hasAny(['desiredDate']) || data.desiredDate is string)
        && (!data.keys().hasAny(['status']) || data.status in ['abierta','en_proceso','resuelta','cancelada']);
    }
    match /requests/{requestId} {
      // Los visitantes pueden leer las necesidades y el WhatsApp autorizado.
      allow get, list: if true;
      allow create: if signedIn()
        && own(request.resource.data)
        && validNeed(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if own(resource.data)
        && validNeed(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','category','city','description','contactPhone',
          'contactConsent','budget','quantity','condition','picture'
        ]);
      // No se crean aplicaciones, aceptaciones ni propuestas.
      allow delete: if own(resource.data);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
